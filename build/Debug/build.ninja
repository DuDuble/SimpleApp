  COMMAND = cd /home/stage/Desktop/SimpleApp/build/Debug/cmake/stm32cubemx && /home/stage/.local/share/stm32cube/bundles/cmake/4.2.3+st.1/bin/cmake --regenerate-during-build -S/home/stage/Desktop/SimpleApp -B/home/stage/Desktop/SimpleApp/build/Debug
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

